+namespace detail {
+// Keep the existing FP32 arithmetic and make its final storage conversion
+// explicit.
+inline C10_HOST_DEVICE Half half_from_float(float value) {
+#if defined(__aarch64__) && !defined(__CUDACC__)
+  return Half(static_cast<float16_t>(value));
+#else
+  return Half(value);
+#endif
+}
+} // namespace detail
+
 /// Arithmetic
 
 inline C10_HOST_DEVICE Half operator+(const Half& a, const Half& b) {
-  return static_cast<float>(a) + static_cast<float>(b);
+  return detail::half_from_float(static_cast<float>(a) + static_cast<float>(b));
 }
 
 inline C10_HOST_DEVICE Half operator-(const Half& a, const Half& b) {
-  return static_cast<float>(a) - static_cast<float>(b);
+  return detail::half_from_float(static_cast<float>(a) - static_cast<float>(b));
 }
 
 inline C10_HOST_DEVICE Half operator*(const Half& a, const Half& b) {
-  return static_cast<float>(a) * static_cast<float>(b);
+  return detail::half_from_float(static_cast<float>(a) * static_cast<float>(b));
 }
 
 inline C10_HOST_DEVICE Half operator/(const Half& a, const Half& b)
     __ubsan_ignore_float_divide_by_zero__ {
-  return static_cast<float>(a) / static_cast<float>(b);
+  return detail::half_from_float(static_cast<float>(a) / static_cast<float>(b));
 }
 
 inline C10_HOST_DEVICE Half operator-(const Half& a) {
@@ -522,7 +534,7 @@
 #elif defined(__SYCL_DEVICE_ONLY__)
   return -c10::bit_cast<sycl::half>(a);
 #else
-  return -static_cast<float>(a);
+  return detail::half_from_float(-static_cast<float>(a));
 #endif
 }
 
