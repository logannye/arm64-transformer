+kernel void index_put_half_reduce(
+    device half* output,
+    device const half* input,
+    device const ulong2* sorted,
+    constant int64_t* sizes,
+    constant int64_t* input_strides,
+    constant IndexPutHalfParams& params,
+    uint tid [[thread_position_in_grid]]) {
+  if (tid >= params.count || sorted[tid].x == ~ulong(0)) {
+    return;
+  }
+  const ulong word = sorted[tid].x / sizeof(uint);
+  if (tid > 0 && sorted[tid - 1].x / sizeof(uint) == word) {
