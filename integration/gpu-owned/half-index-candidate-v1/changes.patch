+    device ulong2* pairs,
+    constant IndexAB* indices,
+    constant int64_t* sizes,
+    constant int64_t* output_strides,
+    constant int64_t* index_iteration_strides,
+    constant int64_t* index_sizes,
+    constant int64_t* indexed_output_strides,
+    constant IndexPutHalfParams& params,
