+// Each pair finds its unique merged rank in the opposite sorted run. The
+// original ordinal resolves equal-destination ties, making the result stable.
+kernel void index_put_half_merge(
+    device const ulong2* input,
+    device ulong2* output,
+    constant IndexPutHalfParams& params,
+    uint tid [[thread_position_in_grid]]) {
+  if (tid >= params.count) {
+    return;
+  }
+  const uint width = params.merge_width;
+  const uint start = (tid / (2 * width)) * (2 * width);
+  const uint middle = min(start + width, params.count);
+  const uint end = min(start + 2 * width, params.count);
+  const bool left = tid < middle;
+  const uint own_start = left ? start : middle;
+  const uint other_start = left ? middle : start;
+  uint lo = other_start;
+  uint hi = left ? end : middle;
+  const ulong2 value = input[tid];
+  while (lo < hi) {
+    const uint mid = lo + (hi - lo) / 2;
+    if (index_put_half_pair_less(input[mid], value)) {
+      lo = mid + 1;
+    } else {
+      hi = mid;
+    }
+  }
+  output[start + (tid - own_start) + (lo - other_start)] = value;
