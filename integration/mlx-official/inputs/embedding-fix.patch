index 0000000000000000000000000000000000000000..a92a68b00211d7647755e3e6627a878c8b3de458
--- /dev/null
+++ b/benchmarks/python/gather_grad_bench.py
@@ -0,0 +1,110 @@
+# Copyright © 2026 Apple Inc.
+
+"""Compare this script on unchanged and patched MLX builds.
+
+For each build, use the same --vocab, --width, --tokens, --pattern, and --compiled
+arguments. Test both small and large vocabularies, unique and repeated indices,
+and token counts around the sort-block boundary (1023, 1024, 1025). Measurements
+include synchronization, and exclude compilation and fixture generation.
+Include sparse cases with vocabularies 32768, 131072, and 1048576 and widths
+1, 32, and 256, as well as small vocabularies with many repeated indices.
+"""
+
+import argparse
+import hashlib
+import json
+import platform
+import time
+
+import mlx.core as mx
+import numpy as np
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--vocab", type=int, default=128)
+    parser.add_argument("--width", type=int, default=64)
+    parser.add_argument("--tokens", type=int, default=512)
+    parser.add_argument(
+        "--pattern", choices=("unique", "uniform", "same", "skewed"), default="skewed"
+    )
+    parser.add_argument("--compiled", action="store_true")
+    parser.add_argument("--repeats", type=int, default=100)
+    parser.add_argument("--warmup", type=int, default=5)
+    parser.add_argument("--label", default="unspecified-build")
+    args = parser.parse_args()
+    if min(args.vocab, args.width, args.tokens, args.repeats) <= 0 or args.warmup < 0:
+        parser.error("shapes and repeat count must be positive")
+    if args.pattern == "unique" and args.tokens > args.vocab:
+        parser.error("unique indices require tokens <= vocab")
+
+    mx.set_default_device(mx.gpu)
+    rng = np.random.default_rng(817)
+    if args.pattern == "unique":
+        indices_np = rng.permutation(args.vocab)[: args.tokens].astype(np.int32)
+    elif args.pattern == "same":
+        indices_np = np.zeros(args.tokens, np.int32)
+    else:
+        indices_np = rng.integers(0, args.vocab, args.tokens, dtype=np.int32)
+        if args.pattern == "skewed":
+            indices_np[np.arange(args.tokens) % 16 != 0] = 0
+    cotangent_np = rng.normal(size=(args.tokens, args.width)).astype(np.float32)
+    expected = np.zeros((args.vocab, args.width), np.float64)
+    np.add.at(expected, indices_np, cotangent_np)
+    weight = mx.zeros((args.vocab, args.width))
+    indices, cotangent = mx.array(indices_np), mx.array(cotangent_np)
+    mx.eval(weight, indices, cotangent)
+
+    def scatter(w, i, c):
+        return w.at[i].add(c)
+
+    def loss(w, i, c):
+        return (w[i] * c).sum()
+
+    operations = {
+        "scatter_add": scatter,
+        "embedding_value_and_grad": mx.value_and_grad(loss),
+    }
+    result = {
+        "schema": 1,
+        "label": args.label,
+        "mlx_version": mx.__version__,
+        "platform": platform.platform(),
+        "arguments": vars(args),
+        "fixture_sha256": hashlib.sha256(
+            indices_np.tobytes() + cotangent_np.tobytes()
+        ).hexdigest(),
+        "scope": "synchronized operator and autograd calls, not full model training",
+        "measurements": {},
+    }
+    for name, operation in operations.items():
+        if args.compiled:
+            operation = mx.compile(operation)
+        for _ in range(args.warmup):
+            mx.eval(operation(weight, indices, cotangent))
+        samples = []
+        for _ in range(args.repeats):
+            start = time.perf_counter_ns()
+            output = operation(weight, indices, cotangent)
+            mx.eval(output)
+            samples.append((time.perf_counter_ns() - start) / 1e6)
+        hashes, errors = [], []
+        for _ in range(10):
+            output = operation(weight, indices, cotangent)
+            gradient = output[1] if name == "embedding_value_and_grad" else output
+            actual = np.array(gradient)
+            hashes.append(hashlib.sha256(actual.tobytes()).hexdigest())
+            errors.append(float(np.max(np.abs(actual.astype(np.float64) - expected))))
+        result["measurements"][name] = {
+            "samples_ms": samples,
+            "p50_ms": float(np.quantile(samples, 0.5)),
+            "p95_ms": float(np.quantile(samples, 0.95)),
+            "replay_sha256": hashes,
+            "byte_repeatable": len(set(hashes)) == 1,
+            "max_absolute_fp64_errors": errors,
+        }
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == "__main__":
+    main()
