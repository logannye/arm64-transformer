+bool is_complete_slice_sum(
+    const std::vector<array>& inputs,
+    const array& out,
+    const std::vector<int>& axes,
+    Scatter::ReduceType reduction) {
+  // Merge sort uses signed int tile offsets. Other scatters keep their path.
+  if (reduction != Scatter::Sum || axes.size() != 1 ||
+      !issubdtype(out.dtype(), inexact) ||
+      inputs[1].size() > (size_t{1} << 30)) {
+    return false;
+  }
+  int idx_ndim = inputs[1].ndim();
+  for (int i = 0; i < out.ndim(); ++i) {
+    int expected = i == axes[0] ? 1 : out.shape(i);
+    if (inputs.back().shape(idx_ndim + i) != expected) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void scatter_slices_sum_gpu(
+    const std::vector<array>& inputs,
+    array& out,
+    int axis,
+    const Stream& s) {
+  auto& d = metal::device(s.device);
+  auto& encoder = metal::get_command_encoder(s);
+  array indices = inputs[1];
+  array updates = inputs.back();
+  if (!indices.flags().row_contiguous) {
+    indices = contiguous_copy_gpu(indices, s);
+    encoder.add_temporary(indices);
+  }
+  if (!updates.flags().row_contiguous) {
+    updates = contiguous_copy_gpu(updates, s);
+    encoder.add_temporary(updates);
+  }
+
+  uint32_t count = indices.size();
+  array keys({static_cast<int>(count)}, uint64, nullptr, {});
+  array order({static_cast<int>(count)}, uint32, nullptr, {});
+  keys.set_data(allocator::malloc(keys.nbytes()));
+  auto keys_name = "scatter_slice_keys_" + type_to_name(indices);
+  auto keys_lib = d.get_library(keys_name, [&]() {
+    std::string source = metal::utils();
+    source += metal::scatter_slices();
+    source += get_template_definition(
+        keys_name, "scatter_slice_keys", get_type_string(indices.dtype()));
+    return source;
+  });
+  auto keys_kernel = d.get_kernel(keys_name, keys_lib);
+  encoder.set_compute_pipeline_state(keys_kernel);
+  encoder.set_input_array(indices, 0);
+  encoder.set_output_array(keys, 1);
+  encoder.set_bytes(out.shape(axis), 2);
+  encoder.dispatch_threads(
+      MTL::Size(count, 1, 1), MTL::Size(std::min<size_t>(count, 256), 1, 1));
+
+  argsort_gpu(keys, order, 0, s);
+
+  bool indexed_rows = count < out.shape(axis);
+  auto sum_name = "scatter_slices_sum_" + type_to_name(out) +
+      (indexed_rows ? "_indexed" : "_dense");
+  auto sum_lib = d.get_library(sum_name, [&]() {
+    std::string source = metal::utils();
+    source += metal::scatter_slices();
+    source += get_template_definition(
+        sum_name,
+        "scatter_slices_sum",
+        get_type_string(out.dtype()),
+        indexed_rows ? "true" : "false");
+    return source;
+  });
+  auto sum_kernel = d.get_kernel(sum_name, sum_lib);
+  size_t slice_size = out.size() / out.shape(axis);
+  size_t trailing_size = 1;
+  for (int i = axis + 1; i < out.ndim(); ++i) {
+    trailing_size *= out.shape(i);
+  }
+  size_t group_size =
+      std::min<size_t>(256, sum_kernel->maxTotalThreadsPerThreadgroup());
+  encoder.set_compute_pipeline_state(sum_kernel);
+  encoder.set_input_array(keys, 0);
+  encoder.set_input_array(order, 1);
+  encoder.set_input_array(updates, 2);
+  encoder.set_output_array(out, 3);
+  encoder.set_bytes(count, 4);
+  encoder.set_bytes(slice_size, 5);
+  encoder.set_bytes(trailing_size, 6);
+  encoder.set_bytes(out.shape(axis), 7);
+  size_t rows = indexed_rows ? count : out.shape(axis);
+  encoder.dispatch_threadgroups(
+      MTL::Size((slice_size + group_size - 1) / group_size, rows, 1),
+      MTL::Size(group_size, 1, 1));
+  encoder.add_temporaries({keys, order});
+}
+
