+    def test_output_dtypes(self):
+        rng = np.random.default_rng(409)
+        indices = mx.array(np.arange(129) % 5, mx.int32)
+        for dtype, vocab in product(
+            (mx.float16, mx.bfloat16, mx.float32, mx.complex64), (7, 257)
+        ):
+            values = rng.normal(size=(129, 33)).astype(np.float32)
+            if dtype == mx.complex64:
+                values = values + 1j * rng.normal(size=values.shape).astype(np.float32)
+            with self.subTest(dtype=dtype, vocab=vocab):
+                if dtype in (mx.float32, mx.complex64):
+                    self.check_gradient(
+                        mx.zeros((vocab, 33), dtype=dtype),
+                        indices,
+                        mx.array(values, dtype=dtype),
+                        compiled=True,
+                    )
+                    continue
+                cotangent = mx.array(values, dtype=dtype)
+                values = np.array(cotangent.astype(mx.float32))
+                expected = np.zeros((vocab, 33), np.float32)
+                round_value = (
+                    (lambda x: x.astype(np.float16).astype(np.float32))
+                    if dtype == mx.float16
+                    else round_bfloat16
+                )
+                for row, update in zip(np.array(indices), values):
+                    expected[row] = round_value(expected[row] + update)
+                fp64 = take_reference((vocab, 33), np.array(indices), values, 0)
+                absolute_sum = take_reference(
+                    (vocab, 33), np.array(indices), np.abs(values), 0
+                )
+                unit_roundoff = 2 ** (-11 if dtype == mx.float16 else -8)
+                terms = 26
+                bound = terms * unit_roundoff / (1 - terms * unit_roundoff)
+                operation = mx.compile(take_gradient)
+                first = None
+                for _ in range(10):
+                    result = operation(
+                        mx.zeros((vocab, 33), dtype=dtype), indices, cotangent
+                    )
+                    actual = np.array(result.astype(mx.float32))
+                    self.assertEqual(actual.tobytes(), expected.tobytes())
+                    self.assertTrue(
+                        np.all(np.abs(actual - fp64) <= bound * absolute_sum + 1e-6)
+                    )
+                    current = array_bytes(result)
+                    if first is None:
+                        first = current
+                    self.assertEqual(current, first)
