+    def test_partial_slice_and_multi_axis_fallback(self):
+        source = mx.zeros((5, 7))
+        indices = mx.array([1, 1, 3])
+        result = source.at[indices, :2].add(mx.ones((3, 2)))
+        expected = np.zeros((5, 7), np.float32)
+        np.add.at(expected, (np.array([1, 1, 3])[:, None], np.arange(2)), 1)
+        np.testing.assert_array_equal(np.array(result), expected)
+        result = source.at[indices, mx.array([2, 2, 4])].add(mx.array([1.0, 2.0, 3.0]))
+        expected = np.zeros((5, 7), np.float32)
+        np.add.at(expected, ([1, 1, 3], [2, 2, 4]), [1, 2, 3])
+        np.testing.assert_array_equal(np.array(result), expected)
