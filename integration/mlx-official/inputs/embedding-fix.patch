+            indices = mx.array([[0, -1, 0, 1], [0, -1, 0, 2]])[:, ::-2].T
+            output_shape = (
+                weight.shape[:axis] + indices.shape + weight.shape[axis + 1 :]
+            )
+            storage_shape = output_shape[:-1] + (output_shape[-1] * 2 + 1,)
