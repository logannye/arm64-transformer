+    def test_embedding_module_and_higher_order(self):
+        rng = np.random.default_rng(533)
+        layer = nn.Embedding(11, 33)
+        layer.weight = mx.zeros((11, 33))
+        indices_np = np.arange(129, dtype=np.int32) % 11
+        cotangent_np = rng.normal(size=(129, 33)).astype(np.float32)
+        indices, cotangent = mx.array(indices_np), mx.array(cotangent_np)
+        gradient = nn.value_and_grad(layer, lambda i, c: (layer(i) * c).sum())
+        gradient = mx.compile(gradient, inputs=layer.state)
+        first = None
+        expected = take_reference(layer.weight.shape, indices_np, cotangent_np, 0)
+        for _ in range(10):
+            _, result = gradient(indices, cotangent)
+            np.testing.assert_allclose(
+                np.array(result["weight"]), expected, rtol=3e-5, atol=3e-4
+            )
+            current = array_bytes(result["weight"])
+            if first is None:
+                first = current
+            self.assertEqual(current, first)
+
+        def loss(w):
+            return mx.square(w[indices]).sum()
+
+        weight = mx.ones((11, 33))
+        second = mx.grad(lambda w: mx.grad(loss)(w).sum())(weight)
+        expected_second = take_reference(
+            weight.shape, indices_np, np.full((129, 33), 2.0), 0
+        )
+        np.testing.assert_array_equal(np.array(second), expected_second)
+
+    def test_vmap_shared_weight(self):
+        rng = np.random.default_rng(953)
+        indices = mx.array(np.arange(51).reshape(3, 17) % 7, mx.int32)
+        cotangent = mx.array(rng.normal(size=(3, 17, 33)).astype(np.float32))
+        weight = mx.zeros((7, 33))
+
+        def objective(w, i, c):
+            return (mx.vmap(lambda row: w[row])(i) * c).sum()
+
+        operation = mx.compile(mx.grad(objective))
+        first = None
+        for _ in range(10):
+            result = operation(weight, indices, cotangent)
+            expected = take_reference(
+                weight.shape, np.array(indices), np.array(cotangent), 0
+            )
+            np.testing.assert_allclose(np.array(result), expected, rtol=3e-5, atol=3e-4)
+            current = array_bytes(result)
+            if first is None:
+                first = current
+            self.assertEqual(current, first)
