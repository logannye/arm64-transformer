+    def test_zero_and_cancellation(self):
+        indices = mx.array(np.arange(257) % 3, mx.int32)
+        cotangent = mx.zeros((257, 17))
+        zero = self.check_gradient(mx.zeros((5, 17)), indices, cotangent, compiled=True)
+        self.assertEqual(array_bytes(zero), bytes(zero.nbytes))
+
+        values = np.tile(np.array([1024, 0.00003, -1024], np.float32), 85)
+        cotangent_np = np.broadcast_to(values[:, None], (values.size, 17)).copy()
+        indices_np = np.zeros(values.size, np.int32)
+        expected = take_reference((5, 17), indices_np, cotangent_np, 0)
+        ordered = np.zeros((5, 17), np.float32)
+        np.add.at(ordered, indices_np, cotangent_np)
+        reordered = np.zeros_like(ordered)
+        permutation = np.arange(values.size).reshape(-1, 3)[:, [0, 2, 1]].reshape(-1)
+        np.add.at(reordered, indices_np[permutation], cotangent_np[permutation])
+        self.assertNotEqual(ordered.tobytes(), reordered.tobytes())
+        operation = mx.compile(take_gradient)
+        first = None
+        for _ in range(10):
+            result = operation(
+                mx.zeros((5, 17)), mx.array(indices_np), mx.array(cotangent_np)
+            )
+            actual = np.array(result)
+            self.assertEqual(actual.tobytes(), ordered.tobytes())
+            # FP32 rounding is separate from repeatability under cancellation.
+            np.testing.assert_allclose(actual, expected, rtol=0, atol=0.01)
+            current = array_bytes(result)
+            if first is None:
+                first = current
+            self.assertEqual(current, first)
+
+    def test_scatter_initial_values_and_untouched_signed_zero(self):
+        source_np = np.full((7, 33), -0.0, dtype=np.float32)
+        source_np[2] = np.linspace(-1, 1, 33)
+        indices_np = np.array([2, -5, 2, -1], np.int32)
+        updates_np = np.arange(132, dtype=np.float32).reshape(4, 33) / 19
+        source = mx.array(source_np)
+        indices = mx.array(indices_np)
+        updates = mx.array(updates_np)
+        expected = source_np.astype(np.float64)
+        np.add.at(expected, indices_np, updates_np)
+        operation = mx.compile(lambda s, i, u: s.at[i].add(u))
+        first = None
+        for _ in range(10):
+            result = operation(source, indices, updates)
+            actual = np.array(result)
+            np.testing.assert_allclose(actual, expected, rtol=3e-5, atol=3e-4)
+            self.assertEqual(actual[0].tobytes(), source_np[0].tobytes())
+            current = array_bytes(result)
+            if first is None:
+                first = current
+            self.assertEqual(current, first)
