+                ..., 1::2
+            ]
+            with self.subTest(axis=axis):
+                self.check_gradient(weight, indices, cotangent, axis, compiled=True)
+        self.check_gradient(
+            mx.zeros((7, 11)),
+            mx.broadcast_to(mx.array(-1), (3, 5)),
+            mx.broadcast_to(mx.array(0.125), (3, 5, 11)),
+        )
