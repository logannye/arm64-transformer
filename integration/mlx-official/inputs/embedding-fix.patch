+# Copyright © 2026 Apple Inc.
+
+import json
+import os
+import subprocess
+import sys
+import unittest
+from itertools import product
+from pathlib import Path
+
+import mlx.core as mx
+import mlx.nn as nn
+import mlx_tests
+import numpy as np
+
+
+def take_reference(shape, indices, cotangent, axis):
+    """Accumulate the supplied (already quantized) cotangent in FP64."""
+    axis %= len(shape)
+    indices = np.asarray(indices)
+    dtype = np.complex128 if np.iscomplexobj(cotangent) else np.float64
+    result = np.zeros(shape, dtype=dtype)
+    permutation = (
+        list(range(axis, axis + indices.ndim))
+        + list(range(axis))
+        + list(range(axis + indices.ndim, cotangent.ndim))
+    )
+    updates = np.transpose(cotangent, permutation).reshape(
+        (indices.size,) + shape[:axis] + shape[axis + 1 :]
+    )
+    np.add.at(np.moveaxis(result, axis, 0), indices.reshape(-1), updates)
+    return result
+
+
+def take_gradient(weight, indices, cotangent, axis=0):
+    return mx.vjp(lambda w: mx.take(w, indices, axis=axis), [weight], [cotangent])[1][0]
+
+
+def array_bytes(value):
+    mx.eval(value)
+    return np.array(value.view(mx.uint8)).tobytes()
+
+
+def round_bfloat16(values):
+    bits = np.asarray(values, dtype=np.float32).view(np.uint32)
+    rounded = (bits + np.uint32(0x7FFF) + ((bits >> 16) & 1)) & np.uint32(0xFFFF0000)
+    return rounded.view(np.float32)
+
+
+def repeatability_worker():
+    mx.set_default_device(mx.gpu)
+    rng = np.random.default_rng(173)
+    indices = np.where(np.arange(257) % 7, 3, -1).astype(np.int32)
+    cotangent = rng.normal(size=(257, 65)).astype(np.float32)
+    weight = mx.zeros((17, 65))
+    operation = mx.compile(take_gradient)
+    expected = take_reference(weight.shape, indices, cotangent, 0)
+    outputs = []
+    for _ in range(10):
+        result = operation(weight, mx.array(indices), mx.array(cotangent))
+        np.testing.assert_allclose(np.array(result), expected, rtol=3e-5, atol=3e-4)
+        outputs.append(array_bytes(result).hex())
+    assert len(set(outputs)) == 1
+    print(json.dumps(outputs[0]))
+
+
+class TestGatherGradient(mlx_tests.MLXTestCase):
+    def setUp(self):
+        super().setUp()
+        if not self.is_apple_silicon or mx.default_device() != mx.gpu:
+            self.skipTest("Metal complete-slice reduction")
+
+    def check_gradient(self, weight, indices, cotangent, axis=0, compiled=False):
+        def operation(w, i, c):
+            return take_gradient(w, i, c, axis)
+
+        if compiled:
+            operation = mx.compile(operation)
+        cotangent_np = np.array(
+            cotangent
+            if cotangent.dtype == mx.complex64
+            else cotangent.astype(mx.float32)
+        )
+        expected = take_reference(weight.shape, np.array(indices), cotangent_np, axis)
+        first = None
+        for _ in range(10):
+            result = operation(weight, indices, cotangent)
+            self.assertEqual(result.shape, weight.shape)
+            self.assertEqual(result.dtype, weight.dtype)
+            actual = np.array(
+                result if result.dtype == mx.complex64 else result.astype(mx.float32)
+            )
+            tolerance = {
+                mx.float16: (2e-3, 2e-3),
+                mx.bfloat16: (8e-3, 8e-3),
+            }.get(weight.dtype, (3e-5, 3e-4))
+            np.testing.assert_allclose(
+                actual, expected, rtol=tolerance[0], atol=tolerance[1]
+            )
+            current = array_bytes(result)
+            if first is None:
+                first = current
+            self.assertEqual(current, first)
+        return result
+
+    def test_repeated_embedding_ids(self):
+        rng = np.random.default_rng(817)
+        for width in (1, 31, 32, 65, 257):
+            for pattern in ("same", "alternating", "skewed", "unique"):
+                count = 257 if pattern != "unique" else 17
+                if pattern == "same":
+                    indices = np.full(count, 3, dtype=np.int32)
+                elif pattern == "alternating":
+                    indices = np.arange(count, dtype=np.int32) % 2
+                elif pattern == "skewed":
+                    indices = np.where(np.arange(count) % 11, 3, -1).astype(np.int32)
+                else:
+                    indices = np.arange(count, dtype=np.int32)
+                cotangent = rng.normal(size=(count, width)).astype(np.float32)
+                for compiled in (False, True):
+                    with self.subTest(width=width, pattern=pattern, compiled=compiled):
+                        self.check_gradient(
+                            mx.zeros((17, width)),
+                            mx.array(indices),
+                            mx.array(cotangent),
+                            compiled=compiled,
+                        )
+
+    def test_multiple_sort_blocks_and_partial_slice_tiles(self):
+        rng = np.random.default_rng(309)
+        for count in (1023, 1024, 1025, 2049):
+            with self.subTest(count=count):
+                indices = rng.integers(-19, 19, size=count, dtype=np.int32)
+                cotangent = rng.normal(size=(count, 259)).astype(np.float32)
+                self.check_gradient(
+                    mx.zeros((19, 259)),
+                    mx.array(indices),
+                    mx.array(cotangent),
+                    compiled=True,
+                )
+
+    def test_axes_scalar_and_empty_indices(self):
+        rng = np.random.default_rng(227)
+        shape = (5, 7, 9)
+        for axis in (0, 1, 2, -1):
+            normalized_axis = axis % len(shape)
+            for indices in (
+                np.array(-1, dtype=np.int32),
+                np.array([[0, -1, 0], [-shape[normalized_axis], 1, -1]], np.int32),
+                np.empty((2, 0), dtype=np.int32),
+            ):
+                cotangent_shape = (
+                    shape[:normalized_axis]
+                    + indices.shape
+                    + shape[normalized_axis + 1 :]
+                )
+                with self.subTest(axis=axis, index_shape=indices.shape):
+                    self.check_gradient(
+                        mx.zeros(shape),
+                        mx.array(indices),
+                        mx.array(rng.normal(size=cotangent_shape).astype(np.float32)),
+                        axis=axis,
+                        compiled=True,
+                    )
+        self.check_gradient(mx.zeros((5, 0)), mx.array([0, 0]), mx.zeros((2, 0)))
+        self.check_gradient(mx.zeros((7,)), mx.array(-7), mx.array(1.25))
