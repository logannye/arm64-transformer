index 0000000000000000000000000000000000000000..2d935e54bc625b6c227bd487b067111b02640480
--- /dev/null
+++ b/mlx/backend/metal/kernels/indexing/scatter_slices.h
@@ -0,0 +1,82 @@
+// Copyright © 2026 Apple Inc.
+
+#include "mlx/backend/metal/kernels/indexing/indexing.h"
+
+template <typename IdxT>
+[[kernel]] void scatter_slice_keys(
+    const device IdxT* indices,
+    device uint64_t* keys,
+    const constant int& axis_size,
+    uint index [[thread_position_in_grid]]) {
+  auto row = offset_neg_idx(indices[index], axis_size);
+  // The position breaks ties, including positive and negative aliases.
+  keys[index] = (uint64_t(row) << 32) | uint64_t(index);
+}
+
+template <typename T, bool IndexedRows>
+[[kernel]] void scatter_slices_sum(
+    const device uint64_t* keys,
+    const device uint32_t* order,
+    const device T* updates,
+    device T* out,
+    const constant uint& count,
+    const constant size_t& slice_size,
+    const constant size_t& trailing_size,
+    const constant int& axis_size,
+    uint2 group [[threadgroup_position_in_grid]],
+    uint tid [[thread_index_in_threadgroup]],
+    uint2 group_size [[threads_per_threadgroup]]) {
+  threadgroup uint3 bounds;
+  if (tid == 0) {
+    uint row = group.y;
+    uint lo = 0;
+    uint hi = count;
+    bool first = true;
+    if constexpr (IndexedRows) {
+      lo = group.y;
+      row = keys[order[lo]] >> 32;
+      first = lo == 0 || (keys[order[lo - 1]] >> 32) != row;
+    }
+    if (!first) {
+      bounds = uint3(0, 0, row);
+    } else {
+      if constexpr (!IndexedRows) {
+        while (lo < hi) {
+          uint mid = lo + (hi - lo) / 2;
+          if ((keys[order[mid]] >> 32) < row) {
+            lo = mid + 1;
+          } else {
+            hi = mid;
+          }
+        }
+      }
+      bounds.x = lo;
+      hi = count;
+      while (lo < hi) {
+        uint mid = lo + (hi - lo) / 2;
+        if ((keys[order[mid]] >> 32) <= row) {
+          lo = mid + 1;
+        } else {
+          hi = mid;
+        }
+      }
+      bounds.y = lo;
+      bounds.z = row;
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+
+  size_t channel = size_t(group.x) * group_size.x + tid;
+  if (channel >= slice_size || bounds.x == bounds.y) {
+    return;
+  }
+  size_t offset =
+      (channel / trailing_size * axis_size + bounds.z) * trailing_size +
+      channel % trailing_size;
+  T value = out[offset];
+  // One writer visits each row's updates in their original logical order.
+  for (uint i = bounds.x; i < bounds.y; ++i) {
+    value = value + updates[size_t(order[i]) * slice_size + channel];
+  }
+  out[offset] = value;
+}
