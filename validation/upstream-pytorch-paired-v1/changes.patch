+    def test_embedding_dense_backward_deterministic_layouts(self, dtype, idx_dtype):
+        def strided(t):
+            # Nonzero storage offset and stride > 1, including the feature axis.
+            storage = torch.empty(tuple(2 * size + 1 for size in t.shape), dtype=t.dtype, device=t.device)
+            view = storage[tuple(slice(1, None, 2) for _ in t.shape)]
+            view.copy_(t)
+            return view
+
+        def layouts(indices, grad):
+            yield indices, grad
+            yield indices.t(), grad.transpose(0, 1)
+            yield strided(indices), strided(grad)
+            yield indices[:, :1].expand(-1, 9), grad[:, :1].expand(-1, 9, -1)
