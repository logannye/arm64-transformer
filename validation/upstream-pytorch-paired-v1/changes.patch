+// Each segment leader is the sole writer of its weight row. The stable GPU
+// sort preserves the logical input order inside the segment. The reduction
+// is serial in that order, including for heavily repeated indices; parallelism
+// comes from independent rows and features, without floating-point atomics.
+template <typename T, typename I, typename O>
+kernel void embedding_dense_backward_deterministic(
+    device const T* grad [[buffer(0)]],
+    device const I* sorted_indices [[buffer(1)]],
+    device const long* original_positions [[buffer(2)]],
+    device float* grad_weight [[buffer(3)]],
+    constant EmbeddingDenseBackwardParams<uint32_t>& params [[buffer(4)]],
+    constant uint2& sizes [[buffer(5)]],
+    device ErrorMessages* error_buf [[buffer(6)]],
+    uint tid [[thread_position_in_grid]]) {
+  const uint feature = tid % params.feature_size;
+  const uint start = tid / params.feature_size;
+  const long weight = static_cast<long>(sorted_indices[start]);
+  if (weight == params.padding_idx ||
+      (start > 0 && sorted_indices[start - 1] == weight)) {
+    return;
+  }
+  if (weight < 0 || weight >= sizes.y) {
+    if (feature == 0) {
+      TORCH_REPORT_ERROR(
+          error_buf,
+          "embedding_dense_backward: index ",
+          weight,
+          " is out of bounds for number of embeddings ",
+          sizes.y);
+    }
+    return;
+  }
+
+  // Find the end of this run without walking it a second time when frequency
+  // scaling is enabled. All positions in [start, end) have the same weight.
+  uint lo = start + 1;
+  uint hi = sizes.x;
+  while (lo < hi) {
+    const uint mid = lo + (hi - lo) / 2;
+    if (sorted_indices[mid] == weight) {
+      lo = mid + 1;
+    } else {
+      hi = mid;
+    }
+  }
+  const uint end = lo;
+  const float count = static_cast<float>(end - start);
+  float sum = 0;
+  for (uint row = start; row < end; ++row) {
+    O grad_outer_offset = 0;
+    O unused_indices_offset = 0;
+    resolve_outer_offsets<O>(
+        static_cast<uint>(original_positions[row]),
+        params,
+        grad_outer_offset,
+        unused_indices_offset);
+    const O offset = grad_outer_offset +
+        static_cast<O>(feature) * params.grad_feature_stride;
+    float value = static_cast<float>(grad[offset]);
+    if (params.scale_grad_by_freq) {
+      value /= count;
+    }
+    sum += value;
+  }
+  grad_weight[weight * params.feature_size + feature] = sum;
+}
